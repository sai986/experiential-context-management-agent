# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Your API key (Anthropic or LiteLLM virtual key starting with sk-)
ANTHROPIC_API_KEY=sk-your-key-here

# Optional: custom base URL for a proxy or internal gateway (e.g. LiteLLM)
# Leave commented out to use the default Anthropic API endpoint.
# ANTHROPIC_BASE_URL=https://your-proxy.example.com/v1

# Set to 1 to make real LLM calls, 0 (default) for free simulated mode.
USE_LLM=0
